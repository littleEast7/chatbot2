# 三、配置文件（config.yaml）

```yaml
window:
  x: 1600
  y: 800

reminders:
  - type: interval
    minutes: 30
    text: "该起来活动一下啦 🧘"

server:
  host: 0.0.0.0
  port: 9000
```

---

# 四、核心代码

## 1️⃣ main.py（入口）

```python
import sys
import threading
from PySide6.QtWidgets import QApplication

from app.config import load_config
from app.ui.assistant import AssistantWindow
from app.scheduler import start_scheduler
from app.server import start_server


def main():
    config = load_config()

    app = QApplication(sys.argv)

    assistant = AssistantWindow(
        gif_path="assets/assistant.gif",
        x=config["window"]["x"],
        y=config["window"]["y"],
    )
    assistant.show()

    # 定时任务
    start_scheduler(config, assistant)

    # HTTP server（后台线程）
    threading.Thread(
        target=start_server,
        args=(config, assistant),
        daemon=True,
    ).start()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
```

---

## 2️⃣ app/config.py

```python
import yaml


def load_config(path="config.yaml"):
    with open(path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)
```

---

## 3️⃣ app/ui/assistant.py（桌面悬浮窗口）

```python
from PySide6.QtWidgets import QLabel, QWidget
from PySide6.QtCore import Qt, QTimer
from PySide6.QtGui import QMovie


class AssistantWindow(QWidget):
    def __init__(self, gif_path, x, y):
        super().__init__()

        self.setWindowFlags(
            Qt.FramelessWindowHint
            | Qt.WindowStaysOnTopHint
            | Qt.Tool
        )
        self.setAttribute(Qt.WA_TranslucentBackground)

        self.label = QLabel(self)
        self.movie = QMovie(gif_path)
        self.label.setMovie(self.movie)
        self.movie.start()

        self.resize(200, 200)
        self.move(x, y)

        self.hide_timer = QTimer()
        self.hide_timer.timeout.connect(self.hide)

    def remind(self, text, duration=5000):
        print(f"[REMIND] {text}")
        self.show()
        self.raise_()
        self.hide_timer.start(duration)
```

> ⚠️ 现在提醒是 `print`，后面你可以加：

* 气泡
* TTS
* 动画切换

---

## 4️⃣ app/scheduler.py（定时提醒）

```python
from apscheduler.schedulers.background import BackgroundScheduler


def start_scheduler(config, assistant):
    scheduler = BackgroundScheduler()

    for r in config.get("reminders", []):
        if r["type"] == "interval":
            scheduler.add_job(
                assistant.remind,
                "interval",
                minutes=r["minutes"],
                args=[r["text"]],
            )

    scheduler.start()
```

---

## 5️⃣ app/server.py（远程控制）

```python
from flask import Flask, request, jsonify

app = Flask(__name__)
assistant_ref = None


@app.route("/remind", methods=["POST"])
def remind():
    data = request.json or {}
    text = data.get("text", "提醒你一下～")
    assistant_ref.remind(text)
    return jsonify({"status": "ok"})


def start_server(config, assistant):
    global assistant_ref
    assistant_ref = assistant

    app.run(
        host=config["server"]["host"],
        port=config["server"]["port"],
    )
```

---

# 五、运行方式

```bash
python main.py
```

然后远程触发：

```bash
curl -X POST http://127.0.0.1:9000/remind \
  -H "Content-Type: application/json" \
  -d '{"text":"喝水时间到啦 💧"}'
```

